{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 6,
  "modules-left": [
    "mango/workspaces",
    "mango/layout",
    "mango/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mango/language",
    "mango/keymode",
    "tray",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/notifications",
    "custom/power"
  ],
  "mango/workspaces": {
    "format": "{icon}",
    "hide-empty": false,
    "on-click": "activate",
    "on-click-right": "toggle",
    "overview-label": "Overview"
  },
  "mango/layout": {
    "format": "{}"
  },
  "mango/window": {
    "format": "{}",
    "max-length": 60,
    "icon": false
  },
  "mango/language": {
    "format": "{}"
  },
  "mango/keymode": {
    "format": "{}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %A}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "network": {
    "interval": 3,
    "format-wifi": "󰖩 {essid}",
    "format-ethernet": "󰈀 {ifname}",
    "format-disconnected": "󰖪 Offline",
    "tooltip-format": "{ipaddr}/{cidr}"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pamixer --toggle-mute",
    "on-scroll-up": "pamixer --increase 2",
    "on-scroll-down": "pamixer --decrease 2"
  },
  "backlight": {
    "format": "󰃠 {percent}%"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁽",
      "󰁿",
      "󰂂"
    ]
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "custom/notifications": {
    "tooltip": false,
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛"
    }
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "wlogout -C ~/.config/mango/wlogout/style.css -l ~/.config/mango/wlogout/layout -b 6 --protocol layer-shell"
  }
}
