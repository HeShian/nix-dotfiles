#!/usr/bin/env bash
set -euo pipefail

# random-anime-wallpaper — 从在线 API 下载随机壁纸，转 PNG 后用 noctalia msg（v5）设为壁纸；Mod+Shift+F10 触发
# 下载失败回退本地随机壁纸；下载目录只保留最新 KEEP_COUNT 张。选项：-k 不清理；-s 静默；-h 帮助
# 改编自 SHORiN-KiWATA/shorin-arch-setup（v4 IPC → v5）。依赖：curl、file、notify-send、ImageMagick、noctalia

# ---------- 默认配置 ----------
API_URL="https://t.alcy.cc/pc/"
# 与 Noctalia 壁纸目录（~/Pictures/wallpapers）保持一致，下载的壁纸才能进壁纸面板
SAVE_DIR="$HOME/Pictures/wallpapers/anime"

KEEP_COUNT=40

# 默认开关状态（可被参数覆盖）
ENABLE_CLEANUP=true
SILENT_MODE=false

# ---------- 参数解析 ----------
usage() {
  echo "用法: $(basename "$0") [-k] [-s] [-h]"
  echo "  -k  (Keep)    保留模式：不清理旧壁纸"
  echo "  -s  (Silent)  静默模式：不发送任何 notify-send 通知"
  echo "  -h  帮助信息"
  exit 0
}

while getopts "ksh" opt; do
  case $opt in
  k) ENABLE_CLEANUP=false ;;
  s) SILENT_MODE=true ;;
  h) usage ;;
  *) usage ;;
  esac
done

# ---------- 辅助函数 ----------

# 统一通知函数（兼容 set -u 下未传 $3 的情况）
send_notify() {
  if [ "$SILENT_MODE" = false ]; then
    notify-send "$1" "$2" ${3:-}
  fi
}

# 失败回退：换一张本地随机壁纸
fallback_random() {
  noctalia msg wallpaper-random > /dev/null 2>&1 || true
}

# ---------- 主逻辑 ----------

mkdir -p "$SAVE_DIR"
# 纳秒级时间戳：快速连按两次快捷键时秒级时间戳会撞名，导致并发 curl 写同一文件
TIMESTAMP=$(date +%s%N)
RAW_PATH="${SAVE_DIR}/wall_${TIMESTAMP}_raw.tmp"
FINAL_PATH="${SAVE_DIR}/wall_${TIMESTAMP}.png"

# 第一步：下载（后台心跳通知，避免长耗时看起来卡死）

if [ "$SILENT_MODE" = false ]; then
  (
    sleep 8
    while true; do
      notify-send "Wallpaper" "Downloading is still in progress..." --expire-time=5000 --icon=drive-harddisk --replace-id=999 || true
      sleep 8
    done
  ) &
  NOTIFY_PID=$!
else
  NOTIFY_PID=""
fi

# 任何提前退出（set -e 触发）都要收掉心跳子进程，否则会留下无限 notify-send 的孤儿循环
trap '[ -n "${NOTIFY_PID:-}" ] && kill "$NOTIFY_PID" 2> /dev/null || true' EXIT

send_notify "Wallpaper" "Downloading from Alcy..." "--expire-time=5000"

USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"

# 下载失败走回退分支（if 包裹避免 curl 非零退出直接触发 set -e）
if ! curl -L -s -A "$USER_AGENT" --connect-timeout 10 -m 120 -o "$RAW_PATH" "$API_URL"; then
  [ -n "${NOTIFY_PID:-}" ] && kill "$NOTIFY_PID" 2> /dev/null || true
  send_notify "Wallpaper Error" "Download failed (Network/API Error), fallback to local random"
  rm -f "$RAW_PATH"
  fallback_random
  exit 1
fi

# 下载结束，停掉心跳通知
if [ -n "${NOTIFY_PID:-}" ]; then
  kill "$NOTIFY_PID" 2> /dev/null || true
fi

# 校验文件大小（过小视为下载失败）
if [ ! -f "$RAW_PATH" ] || [ "$(wc -c < "$RAW_PATH")" -lt 20480 ]; then
  send_notify "Wallpaper Error" "Download failed (File too small/Invalid), fallback to local random"
  rm -f "$RAW_PATH"
  fallback_random
  exit 1
fi

# 校验 MIME 类型（API 出错时可能返回 HTML 而非图片）
FILE_TYPE=$(file --mime-type -b "$RAW_PATH" || echo "unknown")
if [[ $FILE_TYPE != image/* ]]; then
  send_notify "Wallpaper Error" "Not an image file ($FILE_TYPE), fallback to local random"
  rm -f "$RAW_PATH"
  fallback_random
  exit 1
fi

# 第二步：转为 PNG（兼容新版 magick 与旧版 convert 两种命令名）
if command -v magick > /dev/null 2>&1; then
  IMG_TOOL="magick"
elif command -v convert > /dev/null 2>&1; then
  IMG_TOOL="convert"
else
  send_notify "Wallpaper Error" "ImageMagick not found. Please install it."
  rm -f "$RAW_PATH"
  fallback_random
  exit 1
fi

if ! $IMG_TOOL "$RAW_PATH" "$FINAL_PATH"; then
  send_notify "Wallpaper Error" "Failed to convert image to PNG format"
  rm -f "$RAW_PATH" "$FINAL_PATH"
  fallback_random
  exit 1
fi

rm -f "$RAW_PATH"

# 第三步：设为壁纸（不带 connector 参数 = 应用到所有显示器）
if ! noctalia msg wallpaper-set "$FINAL_PATH"; then
  send_notify "Wallpaper Error" "Failed to set wallpaper via Noctalia, fallback to local random"
  fallback_random
  exit 1
fi

# 第四步：后台清理旧壁纸，只保留最新 KEEP_COUNT 张
(
  if [ "$ENABLE_CLEANUP" = true ]; then
    DELETE_START=$((KEEP_COUNT + 1))
    # 文件名只含时间戳、无特殊字符，xargs rm 是安全的
    cd "$SAVE_DIR" && ls -t | tail -n +"$DELETE_START" | xargs -I {} rm -- {} 2> /dev/null || true
  fi
) &

send_notify "Wallpaper Updated" "PNG applied successfully via Noctalia!"
