// 快捷键布局复刻自 SHORiN-KiWATA/shorin-arch-setup (noctalia-dotfiles/.config/niri/binds.kdl)
// 适配：Noctalia v4 IPC (qs ipc call) → v5 (noctalia msg)；kitty → foot；firefox → brave
binds {
    // ============================================================
    // 特殊功能
    // ============================================================
    Mod+Shift+Slash hotkey-overlay-title="快捷键教程 Keybind tutorial" { spawn "~/.config/niri/scripts/niri-binds"; }
    Mod+F1        hotkey-overlay-title="开关输入法 Toggle fcitx" { spawn-sh "pkill fcitx5 || fcitx5 -d"; }
    Mod+F2        hotkey-overlay-title="设置 Settings" { spawn-sh "noctalia msg settings-toggle"; }
    Mod+P         hotkey-overlay-title="提取窗口信息 Pick information" { spawn "~/.config/niri/scripts/niri-pick" "focus"; }

    // ============================================================
    // 应用启动
    // ============================================================
    Mod+Return    hotkey-overlay-title="独立终端 Terminal" { spawn "foot"; }
    Mod+T         hotkey-overlay-title="共享终端 Terminal" { spawn "foot"; }
    Mod+Slash     hotkey-overlay-title="临时终端 Quick Terminal" { spawn "foot" "--app-id" "quickterminal"; }
    Mod+B         hotkey-overlay-title="Zen 浏览器 Zen Browser" { spawn "zen-twilight"; }
    Mod+Alt+B     hotkey-overlay-title="浏览器 Brave Browser" { spawn "brave"; }
    Mod+E         hotkey-overlay-title="文档管理器 Filemanager" { spawn "thunar"; }
    Mod+Alt+O     hotkey-overlay-title="AI助手 opencode agent" { spawn "foot" "--app-id" "opencode" "-e" "opencode"; }

    // ============================================================
    // Noctalia v5 面板
    // ============================================================
    Mod+Z         hotkey-overlay-title="程序菜单 Applauncher" { spawn-sh "noctalia msg panel-toggle launcher || fuzzel"; }
    Mod+Space     hotkey-overlay-title="控制中心 ControlCenter" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Alt+W     hotkey-overlay-title="壁纸切换 Wallpaper" { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+N   hotkey-overlay-title="通知中心 Notifications" { spawn-sh "noctalia msg panel-toggle control-center notifications"; }
    Mod+Shift+P   hotkey-overlay-title="电源菜单 Powermenu" { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Alt+V     hotkey-overlay-title="剪贴板 Clipboard" { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Alt+Tab       hotkey-overlay-title="跳转窗口 Switch windows" { spawn-sh "noctalia msg window-switcher"; }

    // ============================================================
    // 壁纸
    // ============================================================
    Mod+F10       hotkey-overlay-title="随机切换壁纸 Random wallpaper" { spawn-sh "noctalia msg wallpaper-random"; }
    Mod+Shift+F10 hotkey-overlay-title="随机下载壁纸 Random Download wallpaper" { spawn "~/.config/niri/scripts/random-anime-wallpaper"; }

    // ============================================================
    // 总览 / 退出
    // ============================================================
    Mod+O         hotkey-overlay-title="切换总览界面 Toggle overview" repeat=false { toggle-overview; }
    Mod+G         repeat=false { toggle-overview; }
    Mod+Shift+E   hotkey-overlay-title="退出 niri Quit niri" { quit; }

    // ============================================================
    // 关闭窗口
    // ============================================================
    Mod+Q         hotkey-overlay-title="关闭聚焦窗口 Close focus window" repeat=false { close-window; }
    Alt+F4        hotkey-overlay-title="强制杀死窗口 Force kill -9 window" repeat=false { spawn "~/.config/niri/scripts/niri-force-kill-window"; }
    Alt+Shift+F4  hotkey-overlay-title="强制杀死窗口以及关联进程 Force kill -9 a window tree" repeat=false { spawn "~/.config/niri/scripts/niri-force-kill-window" "-f"; }
    Mod+MouseMiddle { close-window; }

    // niri-sidebar 扩展相关（实验性功能，NixOS 未打包 niri-sidebar，暂不可用）
    // Mod+Alt+S hotkey-overlay-title="收起窗口 Move to Sidebar" { spawn "niri-sidebar" "toggle-window"; }
    // Mod+M     hotkey-overlay-title="收起窗口 Move to Sidebar" { spawn "niri-sidebar" "toggle-window"; }
    // Mod+Alt+Z hotkey-overlay-title="展开/收起侧边栏 Toggle Sidebar" { spawn "niri-sidebar" "toggle-visibility"; }
    // Mod+Alt+X { spawn "niri-sidebar" "flip"; }
    // Mod+Alt+R hotkey-overlay-title="重置侧边栏 Reorder Sidebar" { spawn "niri-sidebar" "reorder"; }

    // ============================================================
    // 锁屏 / 挂起
    // ============================================================
    Mod+Alt+L     hotkey-overlay-title="锁屏 Lock Screen" { spawn-sh "noctalia msg session lock"; }
    Mod+Alt+P     hotkey-overlay-title="挂起 Suspend" { spawn-sh "niri msg action power-off-monitors && noctalia msg session lock && systemctl suspend"; }

    // ============================================================
    // 焦点切换
    // ============================================================
    Mod+Left      { focus-column-left; }
    Mod+Down      { focus-window-down; }
    Mod+Up        { focus-window-up; }
    Mod+Right     { focus-column-right; }
    Mod+H         { focus-column-left; }
    Mod+J         { focus-window-down; }
    Mod+K         { focus-window-up; }
    Mod+L         { focus-column-right; }
    Mod+W         { focus-window-up; }
    Mod+S         { focus-window-down; }
    Mod+Home      { focus-column-first; }
    Mod+End       { focus-column-last; }

    // ============================================================
    // 移动列 / 窗口
    // ============================================================
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+A     { move-column-left; }
    Mod+Ctrl+D     { move-column-right; }
    Mod+Ctrl+S     { move-window-down; }
    Mod+Ctrl+W     { move-window-up; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // ============================================================
    // 显示器
    // ============================================================
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+A     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+S     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+W     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+D     { move-column-to-monitor-right; }

    // 移动整个工作区跨显示器（Mod+Shift+Alt + 三组方向键）
    Mod+Shift+Alt+W     { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+S     { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+D     { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+A     { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+K     { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+J     { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+L     { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+H     { move-workspace-to-monitor-left; }
    Mod+Shift+Alt+Up    { move-workspace-to-monitor-up; }
    Mod+Shift+Alt+Down  { move-workspace-to-monitor-down; }
    Mod+Shift+Alt+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Alt+Left  { move-workspace-to-monitor-left; }

    // ============================================================
    // 工作区
    // ============================================================
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+U               { focus-workspace-down; }
    Mod+I               { focus-workspace-up; }
    Mod+Ctrl+U          { move-column-to-workspace-down; }
    Mod+Ctrl+I          { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }
    Mod+Ctrl+0 { move-column-to-workspace 10; }

    // ============================================================
    // 滚轮快捷键
    // ============================================================
    Mod+Shift+WheelScrollDown       hotkey-overlay-title="切换工作区 Change workspaces" cooldown-ms=150 { focus-workspace-down; }
    Mod+Shift+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+Shift+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+Shift+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+WheelScrollDown             hotkey-overlay-title="滚轮切换聚焦 Change focus with wheel" { focus-column-right; }
    Mod+WheelScrollUp               { focus-column-left; }
    Mod+Ctrl+WheelScrollDown        { move-column-right; }
    Mod+Ctrl+WheelScrollUp          { move-column-left; }
    Mod+MouseForward                { focus-window-up; }
    Mod+MouseBack                   { focus-window-down; }

    // ============================================================
    // 列内窗口操作
    // ============================================================
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+A         hotkey-overlay-title="向左移动窗口 Move window to left between columns" { consume-or-expel-window-left; }
    Mod+D         hotkey-overlay-title="向右移动窗口 Move window to right between columns" { consume-or-expel-window-right; }
    Mod+Comma     { consume-window-into-column; }
    Mod+Period    { expel-window-from-column; }
    Mod+Shift+A   { consume-window-into-column; }
    Mod+Shift+D   { expel-window-from-column; }
    Mod+Shift+X   hotkey-overlay-title="标签页 Tabs" { toggle-column-tabbed-display; }

    // ============================================================
    // 尺寸与布局
    // ============================================================
    Mod+R         hotkey-overlay-title="按预设切换宽度 Switch width" { switch-preset-column-width; }
    Mod+Shift+R   { switch-preset-window-height; }
    Mod+Ctrl+R    { reset-window-height; }
    Mod+F         hotkey-overlay-title="最大化 Maximize" { maximize-column; }
    Mod+Alt+F     hotkey-overlay-title="全屏 Fullscreen" { fullscreen-window; }
    Mod+Ctrl+F    { expand-column-to-available-width; }
    Mod+C         { center-column; }
    Mod+Ctrl+C    { center-visible-columns; }
    Mod+Minus     { set-column-width "-5%"; }
    Mod+Equal     { set-column-width "+5%"; }
    Mod+Shift+Minus { set-window-height "-5%"; }
    Mod+Shift+Equal { set-window-height "+5%"; }

    // ============================================================
    // 浮动窗口
    // ============================================================
    Mod+V         hotkey-overlay-title="切换浮动 Toggle floating" { toggle-window-floating; }
    Mod+N         hotkey-overlay-title="切换浮动聚焦 Change focus to floating" { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V   { switch-focus-between-floating-and-tiling; }
    Mod+Alt+N     { switch-focus-between-floating-and-tiling; }
    Alt+grave     { switch-focus-between-floating-and-tiling; }

    // ============================================================
    // 截图 (niri 内建 + 快门声布防)
    // ============================================================
    Print                hotkey-overlay-title="区域截图 Select screenshot" { spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Mod+Alt+A            hotkey-overlay-title="区域截图 Select screenshot" { spawn-sh "niri msg action screenshot --show-pointer false && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Ctrl+Print           { spawn-sh "niri msg action screenshot-window --show-pointer false && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Mod+Alt+Ctrl+A       hotkey-overlay-title="截取聚焦窗口 Focus-window screenshot" { spawn-sh "niri msg action screenshot-window && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Shift+Print          { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Mod+Alt+Ctrl+Shift+A hotkey-overlay-title="截取显示器 Monitor screenshot" { spawn-sh "niri msg action screenshot-screen --show-pointer false && pkill -f -USR1 '[s]creenshot-sound.sh'"; }
    Mod+Shift+S          hotkey-overlay-title="区域截图并编辑 Screenshot and edit" { spawn "~/.config/niri/scripts/screenshot-edit.sh"; }

    // ============================================================
    // 音量 / 亮度 / 媒体 (Noctalia v5)
    // ============================================================
    XF86AudioRaiseVolume    repeat=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume    repeat=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                        { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp     repeat=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown   repeat=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioNext                        { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                        { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                        { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                       { spawn-sh "noctalia msg media toggle"; }

    // ============================================================
    // 其他
    // ============================================================
    Mod+Escape    allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}

// ============================================================
// Recent Windows (缩略图窗口切换)
// ============================================================
recent-windows {
    debounce-ms 750
    open-delay-ms 150

    highlight {
        padding 30
        corner-radius 12
    }

    previews {
        max-height 480
        max-scale 0.2
    }

    binds {
        Mod+Tab            { next-window     scope="workspace"; }
        Mod+Shift+Tab      { previous-window scope="workspace"; }
        Mod+grave          { next-window     filter="app-id"; }
        Mod+Shift+grave    { previous-window filter="app-id"; }
    }
}
